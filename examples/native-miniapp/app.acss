page { background: #f5f7fb; font-family: sans-serif; }
.page { padding: 32rpx; }
.card { padding: 28rpx; margin-bottom: 24rpx; background: white; border-radius: 16rpx; }
.title { font-size: 36rpx; font-weight: bold; margin-bottom: 20rpx; }
button { margin-top: 20rpx; }
input { padding: 20rpx 0; border-bottom: 1px solid #ddd; }
